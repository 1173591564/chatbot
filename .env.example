# ===================== DeepSeek =====================
# 必填：在 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=

# 可选：改用中转/自建服务时填写（默认官方地址）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：自定义系统提示词
# SYSTEM_PROMPT=你是一个简洁专业的中文助手。

# 服务端口
# PORT=3000

# =====================================================
# 联网搜索 / 阅读链接 / 文件解析都由 DeepSeek 官方服务端完成，
# 用的是 deepseek_web_search / deepseek_read_url / POST /files，
# 不再需要任何第三方搜索后端的 key。
#
# 计费（2026-11 公开价，以官网为准）：
#   搜索、抓取各 5 元 / 1000 次；纯文本类文件解析（user_data）不计费。
# 不想产生费用：页面设置里关掉「联网搜索」「阅读链接」即可。
#
# 旧的 TAVILY_API_KEY / BRAVE_API_KEY / SERPER_API_KEY /
# SEARCH_USER_AGENT 已不再读取。
# =====================================================
